{
  "scenarios": [
    {
      "id": "happy",
      "tab": "Happy path",
      "short": "ClusterIP → a pod",
      "q": "How a connection to a ClusterIP reaches one pod",
      "frames": [
        {
          "on": ["A"],
          "badge": "web → 10.96.0.20 (virtual)",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "ready"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "note": "nslookup web → 10.96.0.20",
              "conns": []
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready"
            }
          ],
          "h": "DNS returns the ClusterIP",
          "b": "The cluster DNS resolves <code>web</code> (in full, <code>web.default.svc.cluster.local</code>) to <code>10.96.0.20</code>. The client has no idea how many pods are behind it."
        },
        {
          "on": ["node-1", "node-2", "eps"],
          "badge": "no interface owns 10.96.0.20",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "ready"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "note": "connecting to 10.96.0.20:80",
              "conns": []
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready"
            }
          ],
          "h": "The ClusterIP is virtual",
          "b": "No network interface has <code>10.96.0.20</code> and no process listens on it. kube-proxy on every node has turned the EndpointSlice into rules that match packets sent to it."
        },
        {
          "on": ["node-1"],
          "badge": "random pick per new connection",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "ready"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": [
                {
                  "to": "10.1.1.7",
                  "st": "new",
                  "label": "conn 1: 10.96.0.20 ⇒ 10.1.1.7"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "note": "picked 10.1.1.7 at random",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready",
              "conns": 1
            }
          ],
          "h": "The rules on the client's node pick a pod",
          "b": "The first packet of the new connection matches node-1's rules, which choose one of the three ready pods at random, here <code>10.1.1.7</code> on node-2, and rewrite the destination (DNAT). The packet goes straight there."
        },
        {
          "on": ["A"],
          "badge": "the choice sticks for the connection",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "ready"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "note": "conntrack remembers each connection",
              "conns": [
                {
                  "to": "10.1.1.7",
                  "st": "ok",
                  "label": "conn 1 ⇒ 10.1.1.7 · every packet, both ways"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready",
              "conns": 1
            }
          ],
          "h": "The kernel remembers the choice",
          "b": "Connection tracking records client → <code>10.96.0.20</code> ⇒ <code>10.1.1.7</code>. Every later packet of this connection goes to the same pod, and replies are rewritten so they appear to come from the ClusterIP."
        },
        {
          "on": ["node-1"],
          "badge": "balanced per connection, not per request",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "ready"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": [
                {
                  "to": "10.1.1.7",
                  "st": "ok",
                  "label": "conn 1 ⇒ 10.1.1.7"
                },
                {
                  "to": "10.1.0.4",
                  "st": "new",
                  "label": "conn 2 ⇒ 10.1.0.4 (new pick)"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "note": "picked 10.1.0.4 at random",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready",
              "conns": 1
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready",
              "conns": 1
            }
          ],
          "h": "The next connection is a new pick",
          "b": "A second connection from the same client may land on a different pod. Requests sent over one connection all go to the same pod."
        }
      ],
      "take": "A ClusterIP is an entry in rules that exist on every node, kept in sync from the EndpointSlice. There is no central load balancer in the path.",
      "gen": "L4 load balancing with NAT anywhere: Linux IPVS and LVS, cloud network load balancers. They balance connections, not requests."
    },
    {
      "id": "ready",
      "tab": "Scenario 1",
      "short": "Readiness fails",
      "q": "A pod fails its readiness probe. How does it stop getting traffic without being restarted?",
      "frames": [
        {
          "on": ["b2"],
          "badge": "container still running · restarts 0",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "ready"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": [
                {
                  "to": "10.1.0.5",
                  "st": "ok",
                  "label": "conn 1 ⇒ 10.1.0.5 (opened earlier)"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "ok",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "notready",
              "note": "readiness: 503 × 3 · Ready=False · restarts 0",
              "conns": 1
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready"
            }
          ],
          "h": "Readiness fails",
          "b": "Pod b2 loses its database, and its readiness endpoint returns 503. After the probe's failure threshold, the kubelet sets <code>Ready</code> to False. The container keeps running; nothing restarts it."
        },
        {
          "on": ["eps"],
          "badge": "EndpointSlice: 10.1.0.5 ready: false",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "no"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": [
                {
                  "to": "10.1.0.5",
                  "st": "ok",
                  "label": "conn 1 ⇒ 10.1.0.5"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "stale",
              "note": "not updated yet",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "stale",
              "note": "not updated yet",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "notready",
              "note": "Ready=False · restarts 0",
              "conns": 1
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready"
            }
          ],
          "h": "The EndpointSlice is updated",
          "b": "The EndpointSlice controller marks <code>10.1.0.5</code> as <code>ready: false</code>. The pod is still listed; it just isn't a target any more."
        },
        {
          "on": ["node-1", "node-2"],
          "badge": "every node rebuilds its rules",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "no"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": [
                {
                  "to": "10.1.0.5",
                  "st": "ok",
                  "label": "conn 1 ⇒ 10.1.0.5"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.1.7"],
              "st": "new",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.1.7"],
              "st": "new",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "notready",
              "note": "Ready=False · restarts 0",
              "conns": 1
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready"
            }
          ],
          "h": "Every node's rules are rewritten",
          "b": "kube-proxy on node-1 and node-2 each see the change and rebuild their rules with two targets."
        },
        {
          "on": ["A"],
          "badge": "new connections skip it",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "no"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": [
                {
                  "to": "10.1.0.5",
                  "st": "old",
                  "label": "conn 1 ⇒ 10.1.0.5 · already open, not moved by the Service"
                },
                {
                  "to": "10.1.1.7",
                  "st": "new",
                  "label": "conn 2 ⇒ 10.1.1.7"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.1.7"],
              "st": "ok",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.1.7"],
              "st": "ok",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "notready",
              "note": "Ready=False · restarts 0",
              "conns": 1
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready",
              "conns": 1
            }
          ],
          "h": "New connections skip it",
          "b": "The next connection can only land on <code>10.1.0.4</code> or <code>10.1.1.7</code>. kube-proxy only decides where new connections go; a connection already open to b2 isn't moved by the Service."
        },
        {
          "on": ["b2", "eps"],
          "badge": "back in the rules · still restarts 0",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "ready"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": [
                {
                  "to": "10.1.1.7",
                  "st": "ok",
                  "label": "conn 2 ⇒ 10.1.1.7"
                }
              ]
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "new",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "new",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "ready",
              "note": "Ready=True · restarts 0"
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready",
              "conns": 1
            }
          ],
          "h": "It recovers",
          "b": "The database comes back, the probe passes, and b2 is Ready again. It returns to the EndpointSlice and the rules, all without a restart. A failed liveness probe, by contrast, would have restarted the container."
        }
      ],
      "take": "Readiness means \"don't send me traffic right now\"; liveness means \"restart me\". A readiness check that depends on a shared database can take every pod out at once, so keep it about the pod itself.",
      "gen": "Health checks on any load balancer: an AWS target group or an nginx upstream marks a target unhealthy and stops sending it new traffic, without touching the process."
    },
    {
      "id": "shutdown",
      "tab": "Scenario 2",
      "short": "Shutdown race",
      "q": "During a rollout, why do some requests hit a pod that's already shutting down?",
      "frames": [
        {
          "on": ["b2", "eps"],
          "badge": "shutdown and removal start in parallel",
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "term"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": []
            },
            {
              "n": "client B",
              "node": "node-2",
              "conns": []
            }
          ],
          "rules": {
            "node-1": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "stale",
              "note": "not updated yet",
              "gone": []
            },
            "node-2": {
              "t": ["10.1.0.4", "10.1.0.5", "10.1.1.7"],
              "st": "stale",
              "note": "not updated yet",
              "gone": []
            }
          },
          "pods": [
            {
              "n": "a1",
              "ip": "10.1.0.4",
              "node": "node-1",
              "st": "ready"
            },
            {
              "n": "b2",
              "ip": "10.1.0.5",
              "node": "node-1",
              "st": "term",
              "note": "Terminating · no preStop hook"
            },
            {
              "n": "c3",
              "ip": "10.1.1.7",
              "node": "node-2",
              "st": "ready"
            }
          ],
          "h": "The pod is deleted",
          "b": "A rolling update deletes b2. At the same time the kubelet starts shutting it down and the EndpointSlice marks <code>10.1.0.5</code> as terminating, not ready. The rules on each node still have to catch up."
        },
        {
          "on": ["b2"],
          "badge": "nothing listening on 10.1.0.5",
          "bad": true,
          "eps": [
            {
              "ip": "10.1.0.4",
              "pod": "a1",
              "st": "ready"
            },
            {
              "ip": "10.1.0.5",
              "pod": "b2",
              "st": "term"
            },
            {
              "ip": "10.1.1.7",
              "pod": "c3",
              "st": "ready"
            }
          ],
          "clients": [
            {
              "n": "client A",
              "node": "node-1",
              "conns": []
            },
            {
              "n": "client B",
              "node": "node-2",
              "conns": []
            }
          ],
          "rules": {
            "node-1": {
