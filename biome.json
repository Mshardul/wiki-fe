{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "lib/**/*.{ts,tsx,js,jsx,json}",
      "app/**/*.{ts,tsx,css}",
      "components/**/*.{ts,tsx,css}",
      "css/**/*.css",
      "*.{ts,js,json}",
      "!**/node_modules/**",
      "!**/generated/**",
      "!**/*.min.*",
      "!tsconfig*.json",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "overrides": [
    {
      "includes": ["css/**/*.css"],
      "formatter": { "enabled": false }
    }
  ]
}
