{
  "name": "wiki-fe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm sw:build",
    "sw:build": "serwist build serwist.config.js",
    "start": "next start",
    "content:build": "tsx scripts/build-content.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint --no-error-on-unmatched-pattern 'lib/**/*.ts' 'tests/**/*.ts' 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' && biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.4",
    "@serwist/cli": "9.5.12",
    "@shikijs/rehype": "^4.4.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.10.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "hastscript": "^9.0.1",
    "jsdom": "^30.0.1",
    "katex": "^0.18.5",
    "mdast-util-to-string": "^4.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "serwist": "9.5.12",
    "shiki": "^4.4.3",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "typescript-eslint": "8.69.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "2.1.8",
    "zod": "^4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
